# Backend local development environment variables.
# Copy to .env and adjust to match your root .env (POSTGRES_USER / POSTGRES_PASSWORD).
# When running inside Docker, compose.yaml injects DATABASE_URL directly — this file is not used.

DATABASE_URL=postgresql://admin:password@localhost:5432/expense_db

# Optional — set to override the database used by pytest (defaults to DATABASE_URL).
# TEST_DATABASE_URL=postgresql://admin:password@localhost:5432/expense_db_test

# Optional — override API version prefix (default: v1 → /api/v1).
# API_VERSION=v1
